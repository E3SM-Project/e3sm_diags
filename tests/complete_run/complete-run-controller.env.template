# Complete-run scrontab controller configuration.
# Copy with: make complete-run-scron-config CONFIG=/absolute/path/config.env
# This file must remain outside the repository and should be mode 0600.

# Absolute checkout containing tests/complete_run/complete-run-controller.sh.
REPOSITORY=/absolute/path/to/e3sm_diags
# Output directory for scheduled controller logs.
LOG_DIR=/absolute/path/to/complete-run-controller-logs
# Conda base installation and environment used by the login-node controller.
CONDA_BASE=/absolute/path/to/conda
CONTROLLER_ENV=ed_dev_1084

# Durable CFS output root and Slurm allocation settings.
RESULTS_ROOT=/global/cfs/cdirs/e3sm/www/e3sm_diags/complete-run-test
SLURM_ACCOUNT=replace-with-approved-account
SLURM_QOS=regular
SLURM_WALLTIME=01:00:00

# SimBoard GraphQL IDs and a non-personal token file. Do not put token contents here.
SIMBOARD_REPOSITORY_ID=replace-with-simboard-repository-node-id
SIMBOARD_CATEGORY_ID=replace-with-complete-test-run-reports-category-node-id
SIMBOARD_TOKEN_FILE=/absolute/path/to/non-personal-simboard-token

# Optional PSCRATCH overrides. The controller defaults these there when unset.
# WORKTREE_ROOT=/pscratch/sd/<user>/e3sm_diags/complete-run/worktrees
# ENVIRONMENT_ROOT=/pscratch/sd/<user>/e3sm_diags/complete-run/environments
