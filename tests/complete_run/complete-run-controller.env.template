# Complete-run scrontab controller configuration.
# Copy with: make complete-run-scron-config CONFIG=/absolute/path/config.env
# This file must remain outside the repository and should be mode 0600.
#
# Required static values are set once for this operations installation. Change
# them only when its location, controller installation, or policy changes.
# The main variables to update are CONDA_BASE and E3SM_DIAGS_TOKEN_FILE.

# =============================================================================
# Static operations deployment location
# =============================================================================
# Absolute checkout containing tests/complete_run/complete-run-controller.sh.
REPOSITORY=/global/cfs/projectdirs/e3sm/e3sm_diags/operations/e3sm_diags

# Output directory for scheduled controller logs.
LOG_DIR=/global/cfs/projectdirs/e3sm/e3sm_diags/operations/logs

# Conda base installation and persistent prefix used by the login-node controller.
CONDA_BASE=/absolute/path/to/conda
CONTROLLER_ENV_PREFIX=/global/cfs/projectdirs/e3sm/e3sm_diags/operations/controller-env

# =============================================================================
# Static diagnostics run policy
# =============================================================================
# Durable public CFS output root.
RESULTS_ROOT=/global/cfs/cdirs/e3sm/www/e3sm_diags/complete-run-test

# Perlmutter diagnostics allocation settings. These values are passed by the
# controller to sbatch, so the scheduled policy remains reviewable.
SLURM_PARTITION=regular
SLURM_ACCOUNT=e3sm
SLURM_QOS=regular
SLURM_NODES=1
SLURM_WALLTIME=02:00:00
SLURM_CONSTRAINT=cpu

# Memory for the login-node cron controller, rendered as #SCRON --mem. This is
# distinct from the diagnostics allocation above.
SCRON_MEMORY=8G

# =============================================================================
# Static E3SM Diagnostics configuration
# =============================================================================
# IDs and the token file path are static. Do not put token contents in this file.
E3SM_DIAGS_REPOSITORY_ID=MDEwOlJlcG9zaXRvcnk5NTgwNTM1NQ==
E3SM_DIAGS_CATEGORY_ID=DIC_kwDOBbXfq84DGQZT
E3SM_DIAGS_TOKEN_FILE=/absolute/path/to/non-personal-e3sm-diags-token

# =============================================================================
# Optional local overrides
# =============================================================================
# Leave these commented out to use the scheduler user's PSCRATCH defaults.
# WORKTREE_ROOT=/pscratch/sd/<user>/e3sm_diags/complete-run/worktrees
# ENVIRONMENT_ROOT=/pscratch/sd/<user>/e3sm_diags/complete-run/environments
