#SCRON --output={{LOG_DIR}}/complete-run-reporter-%j.out
#SCRON --open-mode=append
0 16 * * 1 {{REPOSITORY}}/tests/complete_run/complete-run-reporter.sh {{CONFIG_FILE}}

# 17:00 UTC is 09:00 PST (the wrapper skips it during PDT).
#SCRON --account={{ACCOUNT}}
#SCRON --qos=cron
